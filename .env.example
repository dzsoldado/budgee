# Budgee Tracker — environment template.
# Copy to `.env` for Docker (compose.yaml reads it), or to `.env.local` for local dev
# (`bun run dev`). Both are git-ignored. Tests need none of these.

# ─── Server ─────────────────────────────────────────────────────────────────

# Public HTTPS origin of the app, no trailing slash. Must never change once devices are paired.
# Local: http://localhost:5173   Prod: https://budgee.<tailnet>.ts.net or https://budgee.<your-domain>
PUBLIC_ORIGIN=

# One-time secret the FIRST device types to claim the server: until then, whoever knows it owns
# the server. At least 32 random characters (the server warns at start when shorter).
# Generate: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SETUP_SECRET=

# 32 random bytes, base64. Encrypts the stored Google Drive refresh token. Keep it forever:
# switching hosts with a different CONFIG_KEY loses the Drive connection.
# Generate: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
CONFIG_KEY=

# Optional. Enables POST /api/v1/admin/run-daily for an external scheduler. Not needed: the server
# checks every hour itself.
CRON_SECRET=

# ─── Google Drive backups ───────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type: Web application)
# Authorised redirect URI: <PUBLIC_ORIGIN>/api/v1/backups/google/callback
# Enable "Google Drive API". Scope used: drive.file. Publish the app (out of "Testing") or refresh
# tokens expire after 7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Bun server ─────────────────────────────────────────────────────────────
# Under Docker, compose.yaml fixes HOST, PORT, DATABASE_PATH and WEB_DIST inside the container.
# HOST: the address to listen on. Empty means 127.0.0.1 (this machine only), which is what a
# reverse proxy on the same host (Caddy, nginx) needs. Set 0.0.0.0 only to accept connections from
# other machines directly, e.g. inside a container.
HOST=
PORT=8787
DATABASE_PATH=.data/budgee.sqlite
# The web build folder `bun apps/server/entry/bun.ts` serves. Empty means apps/web/dist.
WEB_DIST=
# Setup and pairing are limited to 10 attempts a minute per client IP, the socket's address by
# default. TRUST_PROXY=1 takes the IP from X-Forwarded-For instead. Set only behind a reverse proxy
# that is the sole way in (the compose front-end profiles set it); otherwise anyone could send a new
# X-Forwarded-For with every attempt.
TRUST_PROXY=

# ─── Docker (compose.yaml) ──────────────────────────────────────────────────
# Compose reads these from .env itself; see DEPLOY.md.
# The HTTPS front end: empty (the app alone, at http://127.0.0.1:8787), tailscale or caddy.
# TRUST_PROXY turns on by itself when this names a front end. If you pick the front end with
# `docker compose --profile ...` instead, set TRUST_PROXY=1 above.
COMPOSE_PROFILES=
# Tailscale: an auth key (admin console → Settings → Keys), the machine name in the address
# https://<TS_HOSTNAME>.<tailnet>.ts.net, and funnel (public) or private (your tailnet only).
TS_AUTHKEY=
TS_HOSTNAME=budgee
TS_MODE=funnel
# Caddy: your domain, e.g. budgee.example.com, its DNS pointing at this machine (ports 80, 443).
DOMAIN=
